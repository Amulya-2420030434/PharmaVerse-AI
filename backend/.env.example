APP_NAME=PharmaVerse AI
APP_VERSION=0.1.0
DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pharmaverse

JWT_SECRET=CHANGE_THIS_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

FABRIC_ENABLED=false
FABRIC_GATEWAY_URL=
FABRIC_GATEWAY_SECRET=
FABRIC_GATEWAY_TIMEOUT=5

# SMTP / Email configuration for OTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@pharmaverse.local
SMTP_FROM_NAME=PharmaVerse AI Security
SMTP_TLS=true

# Google OAuth Client Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP Security Parameters
OTP_TTL_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# OpenFDA Live Integration
FDA_API_TIMEOUT_SECONDS=8.0
FDA_CACHE_TTL_SECONDS=3600.0
