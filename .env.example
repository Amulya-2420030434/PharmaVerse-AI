# ==============================================================================
# PharmaVerse AI — Root Environment Configuration Template
# Course & Domain: Service-Oriented Architecture (SOA) & Microservices
# ==============================================================================
# Copy this file to backend/.env and frontend/.env respectively, adjusting values.
# NEVER commit production secrets or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (backend/.env)
# ------------------------------------------------------------------------------
APP_NAME=PharmaVerse AI
APP_VERSION=0.1.0
DEBUG=true

# Database Connection (PostgreSQL 15+)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pharmaverse

# JWT Authentication & Authorization
JWT_SECRET=CHANGE_THIS_SECRET_KEY_MIN_32_CHARS_LONG
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173

# Hyperledger Fabric 2.5 Blockchain Gateway Configuration
FABRIC_ENABLED=false
FABRIC_GATEWAY_URL=
FABRIC_GATEWAY_SECRET=
FABRIC_GATEWAY_TIMEOUT=5.0

# OpenFDA Outbound Verification Cache & Timeout
FDA_API_TIMEOUT_SECONDS=8.0
FDA_CACHE_TTL_SECONDS=3600.0

# Gmail SMTP / Email Configuration for verification links and OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PharmaVerse AI Security
SMTP_TLS=true
FRONTEND_BASE_URL=http://localhost:5173

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP Security Parameters
OTP_TTL_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
AUTH_LINK_TTL_MINUTES=30

# ------------------------------------------------------------------------------
# Frontend Application Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8001/api
VITE_GOOGLE_CLIENT_ID=
